module

public import Utilities.ClassGroupPrimeValues
public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.RingTheory.Ideal.Norm.RelNorm

@[expose] public section

open IsDedekindDomain NumberField
open scoped NumberField nonZeroDivisors

namespace Utilities

variable (K E : Type*) [Field K] [NumberField K] [Field E] [NumberField E] [Algebra K E]

/-- The relative norm on nonzero integral ideals. -/
noncomputable def numberFieldNonzeroIdealNorm : (Ideal (𝓞 E))⁰ →* (Ideal (𝓞 K))⁰ :=
  ((Ideal.relNorm (𝓞 K) : Ideal (𝓞 E) →*₀ Ideal (𝓞 K)).toMonoidHom.comp
    (nonZeroDivisors (Ideal (𝓞 E))).subtype).codRestrict _ fun I =>
      mem_nonZeroDivisors_iff_ne_zero.mpr fun h =>
        (mem_nonZeroDivisors_iff_ne_zero.mp I.property) (Ideal.relNorm_eq_bot_iff.mp h)

/-- The relative norm on nonzero fractional ideals, extending Mathlib's norm
on integral ideals. -/
noncomputable def numberFieldFractionalIdealNorm :
    (FractionalIdeal (𝓞 E)⁰ E)ˣ →* (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  fractionalIdealHomOfPrimeValues fun v => FractionalIdeal.mk0 K
    (numberFieldNonzeroIdealNorm K E ⟨v.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr v.ne_bot⟩)

@[simp]
theorem numberFieldFractionalIdealNorm_mk0 (I : (Ideal (𝓞 E))⁰) :
    numberFieldFractionalIdealNorm K E (FractionalIdeal.mk0 E I) =
      FractionalIdeal.mk0 K (numberFieldNonzeroIdealNorm K E I) :=
  fractionalIdealHomOfPrimeValues_mk0_integral
    ((FractionalIdeal.mk0 K).comp (numberFieldNonzeroIdealNorm K E)) I

/-- Contract a nonzero prime along an extension of number fields. -/
def numberFieldPrimeUnder (q : HeightOneSpectrum (𝓞 E)) : HeightOneSpectrum (𝓞 K) :=
  ⟨q.asIdeal.under (𝓞 K), inferInstance, Ideal.under_ne_bot _ q.ne_bot⟩

theorem numberFieldFractionalIdealNorm_mk0_prime (q : HeightOneSpectrum (𝓞 E)) :
    let p := numberFieldPrimeUnder K E q
    numberFieldFractionalIdealNorm K E
        (FractionalIdeal.mk0 E ⟨q.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr q.ne_bot⟩) =
      FractionalIdeal.mk0 K ⟨p.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr p.ne_bot⟩ ^
        q.asIdeal.inertiaDeg (𝓞 K) := by
  intro p
  let _ : p.asIdeal.IsMaximal := p.isMaximal
  let _ : q.asIdeal.IsMaximal := q.isMaximal
  let _ : q.asIdeal.LiesOver p.asIdeal := ⟨rfl⟩
  rw [numberFieldFractionalIdealNorm_mk0, ← map_pow]
  apply congrArg (FractionalIdeal.mk0 K)
  apply Subtype.ext
  change Ideal.relNorm (𝓞 K) q.asIdeal = p.asIdeal ^ q.asIdeal.inertiaDeg (𝓞 K)
  exact Ideal.relNorm_eq_pow_of_isMaximal q.asIdeal p.asIdeal

private noncomputable def unitOfNonzeroInteger (a : 𝓞 E) (ha : a ≠ 0) : Eˣ :=
  Units.mk0 (algebraMap (𝓞 E) E a) fun h =>
    ha (IsFractionRing.injective (𝓞 E) E (h.trans (map_zero _).symm))

section Principal
variable [FiniteDimensional K E]

private theorem norm_principal_of_integer (a : 𝓞 E) (ha : a ≠ 0) :
    let x := unitOfNonzeroInteger E a ha
    numberFieldFractionalIdealNorm K E (toPrincipalIdeal (𝓞 E) E x) =
      toPrincipalIdeal (𝓞 K) K (Units.map (Algebra.norm K : E →* K) x) := by
  intro x
  have hI : toPrincipalIdeal (𝓞 E) E x = FractionalIdeal.mk0 E
      ⟨Ideal.span {a}, mem_nonZeroDivisors_iff_ne_zero.mpr
        (by simpa only [ne_eq, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot] using ha)⟩ := by
    apply Units.ext
    rw [coe_toPrincipalIdeal, FractionalIdeal.coe_mk0, FractionalIdeal.coeIdeal_span_singleton]
    rfl
  rw [hI, numberFieldFractionalIdealNorm_mk0]
  apply Units.ext
  rw [FractionalIdeal.coe_mk0, coe_toPrincipalIdeal]
  change ((Ideal.relNorm (𝓞 K) (Ideal.span {a}) : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K) =
    FractionalIdeal.spanSingleton (𝓞 K)⁰ (Algebra.norm K (algebraMap (𝓞 E) E a))
  rw [Ideal.relNorm_singleton, FractionalIdeal.coeIdeal_span_singleton,
    Algebra.algebraMap_intNorm (L := E)]

/-- The norm of a principal fractional ideal is generated by the field norm. -/
theorem numberFieldFractionalIdealNorm_principal (x : Eˣ) :
    numberFieldFractionalIdealNorm K E (toPrincipalIdeal (𝓞 E) E x) =
      toPrincipalIdeal (𝓞 K) K (Units.map (Algebra.norm K : E →* K) x) := by
  let ab := IsLocalization.sec (𝓞 E)⁰ (x : E)
  have hdiv : algebraMap (𝓞 E) E ab.1 / algebraMap (𝓞 E) E ab.2.val = (x : E) :=
    (IsFractionRing.mk'_eq_div ab.2).symm.trans (IsLocalization.mk'_sec _ _)
  have ha : ab.1 ≠ 0 := IsLocalization.sec_fst_ne_zero x.ne_zero
  have hb : ab.2.val ≠ 0 := nonZeroDivisors.coe_ne_zero _
  let a := unitOfNonzeroInteger E ab.1 ha
  let b := unitOfNonzeroInteger E ab.2.val hb
  have hx : x = a / b := by
    apply Units.ext
    rw [Units.val_div_eq_div_val]
    exact hdiv.symm
  rw [hx, map_div, map_div, map_div, map_div, norm_principal_of_integer K E ab.1 ha,
    norm_principal_of_integer K E ab.2.val hb]

end Principal

/-- Relative fractional ideal norms compose along a tower. -/
theorem numberFieldFractionalIdealNorm_comp
    (L : Type*) [Field L] [NumberField L] [Algebra E L] [Algebra K L] [IsScalarTower K E L] :
    (numberFieldFractionalIdealNorm K E).comp (numberFieldFractionalIdealNorm E L) =
      numberFieldFractionalIdealNorm K L := by
  apply fractionalIdealHom_ext_on_primes
  intro q
  simp only [MonoidHom.comp_apply, numberFieldFractionalIdealNorm_mk0]
  apply congrArg (FractionalIdeal.mk0 K)
  apply Subtype.ext
  exact Ideal.relNorm_relNorm (𝓞 K) (𝓞 E) q.asIdeal

end Utilities
