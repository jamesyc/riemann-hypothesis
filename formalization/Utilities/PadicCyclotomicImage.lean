@[expose] public section

open scoped Topology NumberField
open NumberField

namespace Utilities

/-- The p-adic cyclotomic character on the Galois group of the chosen algebraic closure. -/
noncomputable def padicCyclotomicUnitsMap (F : Type*) [Field F] (p : ℕ) [Fact p.Prime] :
    Gal(AlgebraicClosure F/F) →* ℤ_[p]ˣ :=
  (cyclotomicCharacter (AlgebraicClosure F) p).comp
    (MulSemiringAction.toRingAut Gal(AlgebraicClosure F/F) (AlgebraicClosure F))

theorem padicCyclotomicUnitsMap_continuous (F : Type*) [Field F] (p : ℕ) [Fact p.Prime] :
    Continuous (padicCyclotomicUnitsMap F p) :=
  cyclotomicCharacter.continuous p F (AlgebraicClosure F)

/-- The image is closed because the absolute Galois group is compact. -/
theorem isClosed_range_padicCyclotomicUnitsMap (F : Type*) [Field F] [CharZero F]
    (p : ℕ) [Fact p.Prime] :
    IsClosed ((padicCyclotomicUnitsMap F p).range : Set ℤ_[p]ˣ) :=
  (isCompact_range (padicCyclotomicUnitsMap_continuous F p)).isClosed

/-- The cyclotomic image of a number field is infinite. Otherwise its
kernel would be open and one finite extension would contain roots of
unity of all p-power orders. -/
theorem infinite_range_padicCyclotomicUnitsMap (F : Type*) [Field F] [NumberField F]
    (p : ℕ) [Fact p.Prime] : Infinite (padicCyclotomicUnitsMap F p).range := by
  classical
  let L := AlgebraicClosure F
  let f := padicCyclotomicUnitsMap F p
  rcases finite_or_infinite f.range with hf | hf
  · exfalso
    let _ : Finite f.range := hf
    have hc : Continuous f.rangeRestrict := (padicCyclotomicUnitsMap_continuous F p).subtype_mk _
    have hpre : f.rangeRestrict ⁻¹' ({1} : Set f.range) = (f.ker : Set Gal(L/F)) := by
      ext σ
      simp [MonoidHom.mem_ker, Subtype.ext_iff]
    have hopen : IsOpen (f.ker : Set Gal(L/F)) := hpre ▸ (isOpen_discrete _).preimage hc
    obtain ⟨D, hD, hker⟩ := (krullTopology_mem_nhds_one_iff F L _).mp (hopen.mem_nhds f.ker.one_mem)
    let _ : NumberField D := NumberField.of_module_finite F D
    let t := Units.torsionOrder D
    have hp : p.Prime := Fact.out
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (max t 1) hp.one_lt
    have hm : 1 < p ^ n := (le_max_right t 1).trans_lt hn
    let _ : NeZero (p ^ n) := ⟨(pow_pos hp.pos n).ne'⟩
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_isPrimitiveRoot L (p ^ n)
    have hfix : ζ ∈ IntermediateField.fixedField D.fixingSubgroup := by
      rw [IntermediateField.mem_fixedField_iff]
      intro σ hσ
      have hσf : f σ = 1 := hker hσ
      have hσmod : modularCyclotomicCharacter L
          (HasEnoughRootsOfUnity.natCard_rootsOfUnity L (p ^ n)) σ.toRingEquiv = 1 := by
        apply Units.ext
        rw [← cyclotomicCharacter.toZModPow]
        change (PadicInt.toZModPow n) ((f σ : ℤ_[p]ˣ) : ℤ_[p]) = _
        simp only [hσf, Units.val_one, map_one]
      exact algEquiv_fixes_root_of_modularCyclotomic_eq_one (p ^ n) hm σ hσmod hζ.pow_eq_one
    have hζD : ζ ∈ D := by simpa only [InfiniteGalois.fixedField_fixingSubgroup] using hfix
    let z : D := ⟨ζ, hζD⟩
    have hz : z ^ (p ^ n) = 1 := Subtype.ext hζ.pow_eq_one
    let a : 𝓞 D := ⟨z, IsIntegral.of_pow (pow_pos hp.pos n) (hz ▸ isIntegral_one)⟩
    have ha : IsPrimitiveRoot a (p ^ n) := by
      apply IsPrimitiveRoot.of_map_of_injective (f := (algebraMap (𝓞 D) D)) _ RingOfIntegers.coe_injective
      exact IsPrimitiveRoot.of_map_of_injective (f := D.val) hζ D.val.injective
    let u : (𝓞 D)ˣ := Units.ofPowEqOne a (p ^ n) ha.pow_eq_one (NeZero.ne (p ^ n))
    have huT : u ∈ Units.torsion D := (CommGroup.mem_torsion u).mpr <|
      isOfFinOrder_iff_pow_eq_one.mpr
        ⟨p ^ n, pow_pos hp.pos n, Units.pow_ofPowEqOne _ _⟩
    have hv : a ^ t = 1 := by
      simpa only [Units.val_pow_eq_pow_val, Units.val_one, u, Units.val_ofPowEqOne] using
        congrArg Units.val (Units.pow_torsionOrder_eq_one D huT)
    exact (not_lt_of_ge (Nat.le_of_dvd (Units.torsionOrder_pos D) (ha.dvd_of_pow_eq_one t hv)))
      ((le_max_left t 1).trans_lt hn)
  · exact hf

/-- The odd p-adic cyclotomic image of a number field has a dense cyclic
subgroup generated by an element of infinite order. -/
theorem exists_denseRange_zpow_padicCyclotomicUnitsMap (F : Type*) [Field F] [NumberField F]
    (p : ℕ) [Fact p.Prime] (hp : p ≠ 2) :
    ∃ x : (padicCyclotomicUnitsMap F p).range,
      DenseRange (fun j : ℤ => x ^ j) ∧ ¬ IsOfFinOrder x := by
  obtain ⟨x, hx⟩ := exists_denseRange_zpow_closedSubgroup_padicUnits p hp _
    (isClosed_range_padicCyclotomicUnitsMap F p)
  refine ⟨x, hx, fun hfin => ?_⟩
  let _ : Finite ↥(Set.range fun j : ℤ => x ^ j) := hfin.finite_zpowers
  have hfinite : (Set.range fun j : ℤ => x ^ j).Finite := Set.toFinite _
  have huniv := hx.closure_range
  rw [hfinite.isClosed.closure_eq] at huniv
  exact (Set.infinite_univ_iff.mpr (infinite_range_padicCyclotomicUnitsMap F p))
    (huniv ▸ hfinite)

end Utilities
