/-- In a cyclic prime-power extension, a degree-one prime outside any
specified modulus has Frobenius generating the group. -/
theorem exists_degreeOne_primeArtin_generates_of_cyclic_primePower
    (K L : Type*) [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsAbelianGalois K L] {p k : ℕ} (hp : p.Prime)
    (τ : Gal(L/K)) (hτ : Subgroup.zpowers τ = ⊤)
    (hcard : Nat.card Gal(L/K) = p ^ (k + 1)) (N : ℕ) (hN : N ≠ 0) :
    ∃ v : HeightOneSpectrum (𝓞 K), v.asIdeal.inertiaDeg ℤ = 1 ∧
      ¬ (rationalPrimeBelow K v).val ∣ N ∧ Subgroup.zpowers (numberFieldPrimeArtin K L v) = ⊤ := by
  let H := Subgroup.zpowers (τ ^ p)
  let M := IntermediateField.fixedField H
  let _ : NumberField M := NumberField.of_module_finite K M
  have ht : orderOf τ = p ^ (k + 1) := by
    rw [← Nat.card_zpowers, hτ, Subgroup.card_top, hcard]
  have hh : Nat.card H = p ^ k := by
    change Nat.card (Subgroup.zpowers (τ ^ p)) = _
    rw [Nat.card_zpowers, orderOf_pow_of_dvd hp.ne_zero (by rw [ht, pow_succ]; exact dvd_mul_left _ _),
      ht, pow_succ, Nat.mul_div_cancel _ hp.pos]
  have hML : Module.finrank M L = p ^ k := by
    rw [← IsGalois.card_aut_eq_finrank M L, ← Nat.card_congr (IntermediateField.subgroupEquivAlgEquiv H).toEquiv, hh]
  have hKM : Nat.card Gal(M/K) = p := by
    rw [IsGalois.card_aut_eq_finrank K M]
    have hr := Module.finrank_mul_finrank K M L
    rw [hML, ← IsGalois.card_aut_eq_finrank K L, hcard, pow_succ'] at hr
    exact Nat.eq_of_mul_eq_mul_right (pow_pos hp.pos k) hr
  let N' := N * (NumberField.discr M).natAbs
  have hN' : N' ≠ 0 := mul_ne_zero hN (Int.natAbs_ne_zero.mpr (NumberField.discr_ne_zero M))
  obtain ⟨v, hv, hvN, hF⟩ := exists_degreeOne_primeArtin_ne_one K M N' hN' (hKM ▸ hp.one_lt)
  let σ := numberFieldPrimeArtin K L v
  have hres : σ.restrictNormal M = numberFieldPrimeArtin K M v :=
    numberFieldPrimeArtin_restrictNormal K L M v (fun Q =>
      inertia_eq_one_of_rational_prime_not_dvd_discr K M v Q
        (fun h => hvN (h.trans (dvd_mul_left _ _))))
  have hσ : σ ∉ H := by
    intro h
    have hk : σ ∈ (AlgEquiv.restrictNormalHom M).ker := by
      rw [M.restrictNormalHom_ker, IntermediateField.fixingSubgroup_fixedField H]
      exact h
    exact hF (hres.symm.trans (MonoidHom.mem_ker.mp hk))
  have hmem : σ ∈ Subgroup.zpowers τ := hτ.symm ▸ Subgroup.mem_top _
  obtain ⟨j, hj⟩ := mem_powers_iff_mem_zpowers.mpr hmem
  have hpj : ¬ p ∣ j := by
    rintro ⟨a, rfl⟩
    apply hσ
    rw [← hj]
    change τ ^ (p * a) ∈ H
    rw [pow_mul]
    exact Subgroup.npow_mem_zpowers (τ ^ p) a
  have hcop : (orderOf τ).Coprime j := by
    rw [ht]
    exact ((hp.coprime_iff_not_dvd).mpr hpj).pow_left _
  refine ⟨v, hv, fun h => hvN (h.trans (dvd_mul_right _ _)), Subgroup.eq_top_of_card_eq _ ?_⟩
  change Nat.card (Subgroup.zpowers σ) = _
  rw [Nat.card_zpowers, ← hj, hcop.orderOf_pow, ht, hcard]

/-- A prescribed nontrivial cyclic prime-power subgroup of a finite
rational Galois group is generated by an arithmetic Frobenius. -/
theorem exists_rational_isArithFrobAt_generating_primePower
    (L : Type) [Field L] [Algebra ℚ L] [NumberField L] [IsGalois ℚ L]
    {p k : ℕ} (hp : p.Prime) (τ : Gal(L/ℚ)) (ht : orderOf τ = p ^ (k + 1))
    (N : ℕ) (hN : N ≠ 0) :
    ∃ (q : ℕ) (P : Ideal (𝓞 L)) (σ : Gal(L/ℚ)), q.Prime ∧ ¬ q ∣ N ∧ P.IsPrime ∧
      (q : 𝓞 L) ∈ P ∧ IsArithFrobAt ℤ σ P ∧ Subgroup.zpowers σ = Subgroup.zpowers τ := by
  let H := Subgroup.zpowers τ
  let E := IntermediateField.fixedField H
  let _ : Algebra ℚ E := E.algebra'
  let _ : NumberField E := NumberField.of_module_finite ℚ E
  let e : H ≃* Gal(L/E) := IntermediateField.subgroupEquivAlgEquiv H
  let τE := e ⟨τ, Subgroup.mem_zpowers τ⟩
  have hτE : Subgroup.zpowers τE = ⊤ := by
    apply Subgroup.eq_top_of_card_eq
    rw [Nat.card_zpowers]
    have he : orderOf τE = orderOf (⟨τ, Subgroup.mem_zpowers τ⟩ : H) :=
      orderOf_injective e.toMonoidHom e.injective _
    rw [he, Subgroup.orderOf_mk, ← Nat.card_zpowers τ]
    exact Nat.card_congr e.toEquiv
  let _ : IsCyclic Gal(L/E) := isCyclic_iff_exists_zpowers_eq_top.mpr ⟨τE, hτE⟩
  let _ : IsAbelianGalois E L := ⟨⟩
  have hcard : Nat.card Gal(L/E) = p ^ (k + 1) := by
    rw [← Nat.card_congr e.toEquiv]
    exact (Nat.card_zpowers τ).trans ht
  obtain ⟨v, hv, hvN, hvgen⟩ :=
    exists_degreeOne_primeArtin_generates_of_cyclic_primePower E L hp τE hτE hcard N hN
  obtain ⟨Q⟩ := numberField_primesOver_nonempty E L v
  let q := rationalPrimeBelow E v
  let σ := (numberFieldPrimeArtin E L v).restrictScalars ℚ
  let _ : Q.val.IsPrime := Q.property.1
  let _ : Q.val.LiesOver v.asIdeal := Q.property.2
  let _ : v.asIdeal.LiesOver (Ideal.span {(q.val : ℤ)}) :=
    ⟨Int.ideal_span_absNorm_eq_self (v.asIdeal.under ℤ)⟩
  let _ : Q.val.LiesOver (Ideal.span {(q.val : ℤ)}) :=
    Ideal.LiesOver.trans Q.val v.asIdeal _
  have hq : (q.val : 𝓞 L) ∈ Q.val :=
    (natCast_mem_iff_dvd_of_liesOver_rationalPrime Q.val q.val q.val).mpr dvd_rfl
  have hσ : IsArithFrobAt ℤ σ Q.val := degreeOne_primeArtin_isArithFrobAt_rat E L v hv Q
  refine ⟨q.val, Q.val, σ, q.property, hvN, Q.property.1, hq, hσ, ?_⟩
  let f : Gal(L/E) →* Gal(L/ℚ) := AlgEquiv.restrictScalarsHom ℚ
  change Subgroup.zpowers (f (numberFieldPrimeArtin E L v)) = H
  rw [← MonoidHom.map_zpowers, hvgen, Subgroup.map_top]
  have hf : f.range = E.fixingSubgroup := by
    ext s
    constructor
    · rintro ⟨u, rfl⟩
      exact (E.fixingSubgroupEquiv.symm u).property
    · intro hs
      exact ⟨E.fixingSubgroupEquiv ⟨s, hs⟩, rfl⟩
  exact hf.trans (IntermediateField.fixingSubgroup_fixedField H)

private theorem mem_of_coprime_powers_mem {G : Type*} [Group G]
    (H : Subgroup G) (g : G) {d m : ℕ} (hcop : d.Coprime m) (hd : g ^ d ∈ H) (hm : g ^ m ∈ H) :
    g ∈ H := by
  have h : Subgroup.zpowers (g ^ d) ⊔ Subgroup.zpowers (g ^ m) ≤ H :=
    sup_le (Subgroup.zpowers_le.mpr hd) (Subgroup.zpowers_le.mpr hm)
  rw [← zpow_natCast g d, ← zpow_natCast g m, Subgroup.zpowers_zpow_sup,
    Int.gcd_natCast_natCast, hcop.gcd_eq_one, Nat.cast_one, zpow_one] at h
  exact Subgroup.zpowers_le.mp h

/-- A Frobenius can satisfy three open subgroup exclusions when there
is a witness and the chosen prime power sends all candidates into the
excluded subgroups. -/
theorem exists_rational_isArithFrobAt_off_openSubgroups_primePower
    {L : Type} [Field L] [Algebra ℚ L] [IsGalois ℚ L] {p r : ℕ} (hp : p.Prime)
    (H A B C : OpenSubgroup Gal(L/ℚ))
    (hex : ∃ g ∈ H, g ∉ A ∧ g ∉ B ∧ g ∉ C)
    (hpow : ∀ g ∈ H, g ^ (p ^ r) ∈ A ∧ g ^ (p ^ r) ∈ B ∧ g ^ (p ^ r) ∈ C)
    (N : ℕ) (hN : N ≠ 0) :
    ∃ (q : ℕ) (P : Ideal (𝓞 L)) (φ : Gal(L/ℚ)), q.Prime ∧ ¬ q ∣ N ∧ P.IsPrime ∧
      (q : 𝓞 L) ∈ P ∧ IsArithFrobAt ℤ φ P ∧ φ ∈ H ∧ φ ∉ A ∧ φ ∉ B ∧ φ ∉ C := by
  let S := H ⊓ A ⊓ B ⊓ C
  obtain ⟨E, hE⟩ := exists_finiteGalois_restriction_fiber_subset_open (S : Set Gal(L/ℚ)) S.isOpen S.one_mem
  let M := E.toIntermediateField
  let _ : Algebra ℚ M := M.algebra'
  let _ : FiniteDimensional ℚ M := E.finiteDimensional
  let _ : NumberField M := NumberField.of_module_finite ℚ M
  let _ : IsGalois ℚ M := E.isGalois
  let π : Gal(L/ℚ) →* Gal(M/ℚ) := AlgEquiv.restrictNormalHom M
  have hker : π.ker ≤ S.toSubgroup := by
    intro g hg
    have he : π g = 1 := hg
    exact hE g (he.trans (map_one π).symm)
  have hkH : π.ker ≤ H.toSubgroup := fun _ h => (hker h).1.1.1
  have hkA : π.ker ≤ A.toSubgroup := fun _ h => (hker h).1.1.2
  have hkB : π.ker ≤ B.toSubgroup := fun _ h => (hker h).1.2
  have hkC : π.ker ≤ C.toSubgroup := fun _ h => (hker h).2
  obtain ⟨g, hgH, hgA, hgB, hgC⟩ := hex
  let n := orderOf (π g)
  let d := ordCompl[p] n
  have hn : n ≠ 0 := (orderOf_pos (π g)).ne'
  have hcop : d.Coprime (p ^ r) := ((Nat.coprime_ordCompl hp hn).pow_left r).symm
  let u := g ^ d
  have huH : u ∈ H := H.toSubgroup.pow_mem hgH d
  obtain ⟨hgpowA, hgpowB, hgpowC⟩ := hpow g hgH
  have huA : u ∉ A := fun h => hgA (mem_of_coprime_powers_mem A.toSubgroup g hcop h hgpowA)
  have huB : u ∉ B := fun h => hgB (mem_of_coprime_powers_mem B.toSubgroup g hcop h hgpowB)
  have huC : u ∉ C := fun h => hgC (mem_of_coprime_powers_mem C.toSubgroup g hcop h hgpowC)
  have hdiv : orderOf (π u) ∣ p ^ n.factorization p := by
    apply orderOf_dvd_of_pow_eq_one
    change (π (g ^ d)) ^ _ = 1
    rw [map_pow, ← pow_mul]
    change (π g) ^ (ordCompl[p] n * ordProj[p] n) = 1
    rw [mul_comm, Nat.ordProj_mul_ordCompl_eq_self]
    exact pow_orderOf_eq_one _
  obtain ⟨k, _, hk⟩ := (Nat.dvd_prime_pow hp).mp hdiv
  have hk₀ : k ≠ 0 := by
    rintro rfl
    have h : π u = 1 := orderOf_eq_one_iff.mp (hk.trans (pow_zero p))
    exact huA (hkA (MonoidHom.mem_ker.mpr h))
  obtain ⟨k', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk₀
  obtain ⟨q, Q, σ, hq, hqN, hQ, hQq, hσ, hσgen⟩ :=
    exists_rational_isArithFrobAt_generating_primePower M hp (π u) hk N hN
  let _ : Fact q.Prime := ⟨hq⟩
  let _ : Q.IsPrime := hQ
  obtain ⟨P, φ, hP, hPq, hφσ, hφ⟩ := exists_isArithFrobAt_lift_from_finite_prime E (p := q) Q hQq hσ
  have hmem (T : OpenSubgroup Gal(L/ℚ)) (hT : π.ker ≤ T.toSubgroup) :
      φ ∈ T ↔ u ∈ T := by
    let V := T.toSubgroup.map π
    have hpre : V.comap π = T.toSubgroup := by
      change (T.toSubgroup.map π).comap π = T.toSubgroup
      rw [Subgroup.comap_map_eq, sup_eq_left.mpr hT]
    have he (x : Gal(L/ℚ)) : π x ∈ V ↔ x ∈ T := by
      change x ∈ V.comap π ↔ x ∈ T.toSubgroup
      rw [hpre]
    have hf : Subgroup.zpowers (π φ) = Subgroup.zpowers (π u) :=
      (show π φ = σ from hφσ).symm ▸ hσgen
    rw [← he φ, ← he u, ← Subgroup.zpowers_le, ← Subgroup.zpowers_le, hf]
  exact ⟨q, P, φ, hq, hqN, hP, hPq, hφ, (hmem H hkH).mpr huH,
    fun h => huA ((hmem A hkA).mp h), fun h => huB ((hmem B hkB).mp h), fun h => huC ((hmem C hkC).mp h)⟩

end Utilities
