module

public import Utilities.ArtinIdeal
public import Utilities.RelativeFractionalIdealNorm
import Mathlib.RingTheory.RamificationInertia.Inertia

@[expose] public section

open IsDedekindDomain NumberField
open scoped NumberField IsMulCommutative nonZeroDivisors

namespace Utilities

variable (K E L : Type*) [Field K] [NumberField K] [Field E] [NumberField E]
  [Field L] [NumberField L] [Algebra K E] [Algebra E L] [Algebra K L] [IsScalarTower K E L]
  [FiniteDimensional E L] [FiniteDimensional K L]
  [IsAbelianGalois K L] [IsAbelianGalois E L]

/-- Over an intermediate field the Frobenius at a prime is the Frobenius
over the base raised to the intermediate residue degree. -/
theorem numberFieldPrimeArtin_restrictScalars_eq_pow (q : HeightOneSpectrum (𝓞 E))
    (hI : ∀ (P : Ideal (𝓞 L)) [P.IsPrime], P ≠ ⊥ → ∀ τ ∈ P.inertia Gal(L/K), τ = 1) :
    let p := numberFieldPrimeUnder K E q
    (numberFieldPrimeArtin E L q).restrictScalars K =
      numberFieldPrimeArtin K L p ^ q.asIdeal.inertiaDeg (𝓞 K) := by
  intro p
  let _ : q.asIdeal.LiesOver p.asIdeal := ⟨rfl⟩
  obtain ⟨P⟩ := numberField_primesOver_nonempty E L q
  let _ : P.val.IsPrime := P.property.1
  let _ : P.val.LiesOver q.asIdeal := P.property.2
  have hPE : P.val.under (𝓞 E) = q.asIdeal := (Ideal.over_def P.val q.asIdeal).symm
  have hPK : P.val.under (𝓞 K) = p.asIdeal := by
    change P.val.under (𝓞 K) = q.asIdeal.under (𝓞 K)
    rw [← Ideal.under_under (B := 𝓞 E), hPE]
  let Q : p.asIdeal.primesOver (𝓞 L) := ⟨P.val, inferInstance, ⟨hPK.symm⟩⟩
  let a := numberFieldPrimeArtin K L p
  let b : Gal(L/K) := (numberFieldPrimeArtin E L q).restrictScalars K
  let n := q.asIdeal.inertiaDeg (𝓞 K)
  let m := Ideal.Quotient.mk P.val
  have ha (x : 𝓞 L) : m (a • x) = m x ^ p.asIdeal.absNorm := by
    have hx := (numberFieldPrimeArtin_spec K L p Q).mk_apply x
    change m (a • x) = m x ^ Nat.card (𝓞 K ⧸ P.val.under (𝓞 K)) at hx
    simpa only [hPK, Ideal.absNorm_eq_natCard] using hx
  have hb (x : 𝓞 L) : m (b • x) = m x ^ q.asIdeal.absNorm := by
    have hx := (numberFieldPrimeArtin_spec E L q P).mk_apply x
    change m (b • x) = m x ^ Nat.card (𝓞 E ⧸ P.val.under (𝓞 E)) at hx
    simpa only [hPE, Ideal.absNorm_eq_natCard] using hx
  have hpow (k : ℕ) (x : 𝓞 L) : m (a ^ k • x) = m x ^ (p.asIdeal.absNorm ^ k) := by
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ', mul_smul, ha, ih, ← pow_mul, ← pow_succ]
  have hnorm : p.asIdeal.absNorm ^ n = q.asIdeal.absNorm :=
    Ideal.absNorm_pow_inertiaDeg p.asIdeal q.asIdeal
  have hres (x : 𝓞 L) : m (b • x) = m (a ^ n • x) := (hb x).trans (hnorm ▸ hpow n x).symm
  change b = a ^ n
  apply mul_inv_eq_one.mp
  apply hI P.val (Ideal.ne_bot_of_liesOver_of_ne_bot q.ne_bot P.val)
  apply Ideal.mem_inertia.mpr
  intro x
  apply Ideal.Quotient.eq.mp
  change m ((b * (a ^ n)⁻¹) • x) = m x
  rw [mul_smul, hres, ← mul_smul, mul_inv_cancel, one_smul]

/-- The Artin map commutes with relative norms in an extension unramified
at the finite primes. -/
theorem numberFieldIdealArtin_comp_norm
    (hI : ∀ (P : Ideal (𝓞 L)) [P.IsPrime], P ≠ ⊥ → ∀ τ ∈ P.inertia Gal(L/K), τ = 1) :
    (numberFieldIdealArtin K L).comp (numberFieldFractionalIdealNorm K E) =
      (AlgEquiv.restrictScalarsHom K).comp (numberFieldIdealArtin E L) := by
  apply fractionalIdealHom_ext_on_primes
  intro q
  simp only [MonoidHom.comp_apply, numberFieldFractionalIdealNorm_mk0_prime, map_pow,
    numberFieldIdealArtin_mk0_prime]
  exact (numberFieldPrimeArtin_restrictScalars_eq_pow K E L q hI).symm

omit [Algebra K E] [Algebra E L] [IsScalarTower K E L]
  [FiniteDimensional E L] [IsAbelianGalois E L] in
/-- Every fractional ideal norm from the top field is in the Artin kernel. -/
theorem numberFieldFractionalIdealNorm_range_le_artin_ker
    (hI : ∀ (P : Ideal (𝓞 L)) [P.IsPrime], P ≠ ⊥ → ∀ τ ∈ P.inertia Gal(L/K), τ = 1) :
    (numberFieldFractionalIdealNorm K L).range ≤ (numberFieldIdealArtin K L).ker := by
  rintro _ ⟨I, rfl⟩
  apply MonoidHom.mem_ker.mpr
  have h := DFunLike.congr_fun (numberFieldIdealArtin_comp_norm K L L hI) I
  have htop : numberFieldIdealArtin L L I = 1 := Subsingleton.elim _ _
  simpa only [MonoidHom.comp_apply, htop, map_one] using h

omit [Algebra K E] [Algebra E L] [IsScalarTower K E L]
  [FiniteDimensional E L] [IsAbelianGalois E L] in
/-- Principal ideals generated by field norms are killed by Artin. -/
theorem numberFieldIdealArtin_principal_norm_eq_one
    (hI : ∀ (P : Ideal (𝓞 L)) [P.IsPrime], P ≠ ⊥ → ∀ τ ∈ P.inertia Gal(L/K), τ = 1)
    (x : Lˣ) :
    numberFieldIdealArtin K L (toPrincipalIdeal (𝓞 K) K (Units.map (Algebra.norm K : L →* K) x)) = 1 := by
  rw [← numberFieldFractionalIdealNorm_principal]
  exact MonoidHom.mem_ker.mp
    (numberFieldFractionalIdealNorm_range_le_artin_ker K L hI ⟨_, rfl⟩)

end Utilities
