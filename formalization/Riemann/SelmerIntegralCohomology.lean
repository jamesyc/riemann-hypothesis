/-- The closed normal subgroup generated by inertia at finite places
away from `ℓ`. Its quotient allows ramification at primes above `ℓ`
and at infinite places. -/
noncomputable def numberFieldPrimeRamificationKernel (F : Type) [Field F] [NumberField F]
    (ℓ : ℕ) : Subgroup (Field.absoluteGaloisGroup F) :=
  (Subgroup.normalClosure
    {g | ∃ H ∈ numberFieldRelaxedSelmerRestrictions F ℓ, g ∈ H}).topologicalClosure

instance (F : Type) [Field F] [NumberField F] (ℓ : ℕ) :
    (numberFieldPrimeRamificationKernel F ℓ).Normal := by
  exact Subgroup.is_normal_topologicalClosure _

/-- The Galois group allowing ramification only at the places above this
prime and at infinite places. -/
abbrev NumberFieldPrimeRamifiedGaloisGroup (F : Type) [Field F] [NumberField F] (ℓ : ℕ) :=
  Field.absoluteGaloisGroup F ⧸ numberFieldPrimeRamificationKernel F ℓ

theorem numberFieldPrimeRamificationKernel_isClosed
    (F : Type) [Field F] [NumberField F] (ℓ : ℕ) :
    IsClosed (numberFieldPrimeRamificationKernel F ℓ : Set (Field.absoluteGaloisGroup F)) :=
  isClosed_closure

theorem numberFieldRelaxedSelmerRestriction_le_ramificationKernel
    (F : Type) [Field F] [NumberField F] (ℓ : ℕ)
    {H : Subgroup (Field.absoluteGaloisGroup F)} (hH : H ∈ numberFieldRelaxedSelmerRestrictions F ℓ) :
    H ≤ numberFieldPrimeRamificationKernel F ℓ :=
  fun _ hg => subset_closure (Subgroup.subset_normalClosure ⟨H, hH, hg⟩)

theorem numberFieldPrimeRamificationKernel_le_cyclotomicKernel
    (F : Type) [Field F] [NumberField F] (ℓ : ℕ) [Fact ℓ.Prime] :
    numberFieldPrimeRamificationKernel F ℓ ≤ (padicCyclotomicUnitsMap F ℓ).ker := by
  apply closure_minimal _ (isClosed_eq (padicCyclotomicUnitsMap_continuous F ℓ) continuous_const)
  change Subgroup.normalClosure _ ≤ (padicCyclotomicUnitsMap F ℓ).ker
  apply Subgroup.normalClosure_le_normal
  rintro g ⟨H, ⟨v, P, hℓ, hP, hv, rfl⟩, hg⟩
  let _ : P.IsPrime := hP
  have hPℓ : (ℓ : 𝓞 (AlgebraicClosure F)) ∉ P := by
    intro hmem
    apply hℓ
    rw [← hv]
    change NumberField.RingOfIntegers.mapRingHom (algebraMap F (AlgebraicClosure F)) (ℓ : 𝓞 F) ∈ P
    rwa [map_natCast]
  exact cyclotomicCharacter_eq_one_of_mem_absoluteInertia F ℓ hPℓ hg

/-- The cyclotomic character on the quotient unramified away from `ℓ`. -/
noncomputable def numberFieldPrimeRamifiedCyclotomicUnits (F : Type) [Field F] [NumberField F]
    (ℓ : ℕ) [Fact ℓ.Prime] : NumberFieldPrimeRamifiedGaloisGroup F ℓ →* ℤ_[ℓ]ˣ :=
  QuotientGroup.lift (numberFieldPrimeRamificationKernel F ℓ) (padicCyclotomicUnitsMap F ℓ)
    (numberFieldPrimeRamificationKernel_le_cyclotomicKernel F ℓ)

@[simp]
theorem numberFieldPrimeRamifiedCyclotomicUnits_mk (F : Type) [Field F] [NumberField F]
    (ℓ : ℕ) [Fact ℓ.Prime] (g : Field.absoluteGaloisGroup F) :
    numberFieldPrimeRamifiedCyclotomicUnits F ℓ (QuotientGroup.mk g) =
      cyclotomicCharacter (AlgebraicClosure F) ℓ g.toRingEquiv :=
  rfl

theorem numberFieldPrimeRamifiedCyclotomicUnits_continuous (F : Type) [Field F] [NumberField F]
    (ℓ : ℕ) [Fact ℓ.Prime] : Continuous (numberFieldPrimeRamifiedCyclotomicUnits F ℓ) := by
  apply (QuotientGroup.isQuotientMap_mk (numberFieldPrimeRamificationKernel F ℓ)).continuous_iff.mpr
  exact padicCyclotomicUnitsMap_continuous F ℓ

/-- The compact integral Tate coefficient with exponent `n`, on the
Galois group unramified away from `ℓ`. -/
noncomputable def numberFieldIntegralTateTwist (F : Type) [Field F] [NumberField F]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℤ) :
    TopRep.{0} ℤ_[ℓ] (NumberFieldPrimeRamifiedGaloisGroup F ℓ) :=
  TopRep.of (continuousScalarRepresentation (V := ℤ_[ℓ])
    ((Units.coeHom ℤ_[ℓ]).comp ((zpowGroupHom n).comp (numberFieldPrimeRamifiedCyclotomicUnits F ℓ))))

/-- On an absolute Galois representative the action is the indicated
cyclotomic power on the compact integral coefficient. -/
theorem numberFieldIntegralTateTwist_ρ_mk (F : Type) [Field F] [NumberField F]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℤ) (g : Field.absoluteGaloisGroup F) (a : ℤ_[ℓ]) :
    (numberFieldIntegralTateTwist F ℓ n).ρ (QuotientGroup.mk g) a =
      ((cyclotomicCharacter (AlgebraicClosure F) ℓ g.toRingEquiv ^ n : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) * a :=
  rfl

/-- The degree-two cohomology paired with the inverse twist of index `i`. -/
noncomputable abbrev numberFieldIntegralTateH2 (F : Type) [Field F] [NumberField F]
    (ℓ : ℕ) [Fact ℓ.Prime] (i : ℕ) :=
  continuousCohomology 2 (numberFieldIntegralTateTwist F ℓ ((i : ℤ) + 1))

/-- The roots of unity required by the small-prime torsion estimate. -/
def HasSmallPrimeTorsionRoots (F : Type) [Field F] (ℓ : ℕ) : Prop :=
  ∃ z : F, IsPrimitiveRoot z (if ℓ = 2 then 4 else ℓ)

theorem HasSmallPrimeTorsionRoots.map {F L : Type} [Field F] [Field L] [Algebra F L]
    {ℓ : ℕ} (h : HasSmallPrimeTorsionRoots F ℓ) : HasSmallPrimeTorsionRoots L ℓ := by
  obtain ⟨z, hz⟩ := h
  exact ⟨algebraMap F L z, hz.map_of_injective (algebraMap F L).injective⟩

theorem HasSmallPrimeTorsionRoots.isTotallyComplex {F : Type} [Field F] [NumberField F]
    {ℓ : ℕ} (h : HasSmallPrimeTorsionRoots F ℓ) (hℓ : ℓ.Prime) : NumberField.IsTotallyComplex F := by
  obtain ⟨z, hz⟩ := h
  let n := if ℓ = 2 then 4 else ℓ
  have hn : 2 < n := by
    dsimp [n]
    split_ifs with htwo
    · decide
    · have := hℓ.two_le
      omega
  let _ : NeZero n := ⟨by omega⟩
  let M := IntermediateField.adjoin ℚ {z}
  let _ : IsCyclotomicExtension {n} ℚ M := hz.intermediateField_adjoin_isCyclotomicExtension ℚ
  let _ : NumberField.IsTotallyComplex M := IsCyclotomicExtension.Rat.isTotallyComplex M hn
  exact NumberField.isTotallyComplex_of_algebra M F

/-- The quantitative torsion allowance in the reference-layer argument. -/
noncomputable def selmerIntegralTorsionBudget (F : Type) [Field F] [NumberField F]
    (i : ℕ) (K : ℝ) : ℝ :=
  Real.exp ((2 * (i : ℝ) * (Module.finrank ℚ F : ℝ)) ^ K *
    Real.log (2 * ((NumberField.discr F).natAbs : ℝ)))

/-- The Poitou–Tate comparison from the inverse-twist Selmer length to
the degree-two cohomology of the compact dual Tate coefficient. -/
theorem selmerLength_le_integralTateH2_length (F : Type) [Field F] [NumberField F]
    (ℓ : ℕ) [Fact ℓ.Prime] (hF : NumberField.IsTotallyComplex F) (i : ℕ) (hi : 1 ≤ i) :
    numberFieldSelmerLengths F ℓ i ≤ Module.length ℤ_[ℓ] (numberFieldIntegralTateH2 F ℓ i) := by
  sorry

/-- The quantitative torsion bound on the actual degree-two integral Tate cohomology. -/
def SelmerIntegralTorsionBound (K : ℝ) : Prop :=
  ∀ (F : Type) [Field F] [NumberField F] (ℓ : ℕ) [Fact ℓ.Prime],
    NumberField.IsTotallyComplex F → HasSmallPrimeTorsionRoots F ℓ →
    ∀ i : ℕ, 1 ≤ i →
      Finite (numberFieldIntegralTateH2 F ℓ i) ∧
        Real.log (Nat.card (numberFieldIntegralTateH2 F ℓ i) : ℝ) ≤ selmerIntegralTorsionBudget F i K

/-- The uniform quantitative torsion estimate. This is the arithmetic
input called Lemma K in the archive. -/
theorem exists_selmerIntegralTateH2_torsionBudget :
    ∃ K : ℝ, 1 ≤ K ∧ SelmerIntegralTorsionBound K := by
  sorry

/-- A logarithmic cardinality bound for the integral cohomology yields an
ordinary finite composition-length bound for the Selmer group. -/
theorem selmerLength_le_of_integralTateH2_torsionBudget
    (F : Type) [Field F] [NumberField F] (ℓ : ℕ) [Fact ℓ.Prime]
    (i : ℕ) (B : ℝ)
    (hcomparison : numberFieldSelmerLengths F ℓ i ≤ Module.length ℤ_[ℓ] (numberFieldIntegralTateH2 F ℓ i))
    (hfin : Finite (numberFieldIntegralTateH2 F ℓ i))
    (hbudget : Real.log (Nat.card (numberFieldIntegralTateH2 F ℓ i) : ℝ) ≤ B) :
    let s := numberFieldSelmerLengths F ℓ i
    s ≠ ⊤ ∧ ((s.untopD 0 : ℕ) : ℝ) ≤ 2 * B := by
  let M := numberFieldIntegralTateH2 F ℓ i
  let n := (Module.length ℤ_[ℓ] M).toNat
  have hn : Module.length ℤ_[ℓ] M ≠ ⊤ :=
    Module.length_ne_top_iff.mpr ((padicModule_isFiniteLength_iff_finite ℓ M).mpr hfin)
  have hcard : Nat.card M = ℓ ^ n :=
    card_eq_padic_prime_pow_of_isFiniteLength ℓ M (Module.length_ne_top_iff.mp hn)
  have hb : Real.log (Nat.card M : ℝ) ≤ B := hbudget
  rw [hcard, Nat.cast_pow, Real.log_pow] at hb
  have hlog : (1 / 2 : ℝ) ≤ Real.log ℓ := by
    have hℓ : 2 ≤ ℓ := (Fact.out : ℓ.Prime).two_le
    have h := Real.log_le_log (by norm_num : (0 : ℝ) < 2) (by exact_mod_cast hℓ : (2 : ℝ) ≤ ℓ)
    linarith [Real.log_two_gt_d9]
  have hnB : (n : ℝ) ≤ 2 * B := by
    linarith only [hb, mul_le_mul_of_nonneg_left hlog (Nat.cast_nonneg n)]
  have hlen : numberFieldSelmerLengths F ℓ i ≤ (n : WithTop ℕ) :=
    hcomparison.trans_eq (ENat.natCast_toNat hn).symm
  refine ⟨ne_top_of_le_ne_top WithTop.coe_ne_top hlen, ?_⟩
  have h := WithTop.untopD_le (a := 0) hlen
  exact (by exact_mod_cast h : (((numberFieldSelmerLengths F ℓ i).untopD 0 : ℕ) : ℝ) ≤ n).trans hnB

end Riemann
